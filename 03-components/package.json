{
  "name": "@smego/ui",
  "version": "0.1.0",
  "description": "SME.GO Marketplace React component library — WCAG 2.2 AA, Thai-first",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./primitives": "./src/primitives.ts",
    "./strings": "./src/lib/strings.th.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:a11y": "vitest run tests/a11y",
    "build:fixture": "esbuild tests/e2e/fixture/app.tsx --bundle --outfile=tests/e2e/fixture/app.js --loader:.tsx=tsx --jsx=automatic --define:process.env.NODE_ENV='\"production\"' && tailwindcss -i tests/e2e/fixture/app.in.css -o tests/e2e/fixture/app.css",
    "test:e2e": "npm run build:fixture && npm run gallery:build && playwright test",
    "gallery:build": "esbuild gallery/gallery.tsx --bundle --outfile=gallery/gallery.js --loader:.tsx=tsx --jsx=automatic --define:process.env.NODE_ENV='\"development\"' && tailwindcss -i gallery/gallery.in.css -o gallery/gallery.css",
    "gallery": "npm run gallery:build && http-server gallery -p 4400 -c-1 -o",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm run gallery:build && npm run check:bundle && node ../02-tokens/validate-tokens.js",
    "verify:head": "node ../02-tokens/verify-head.mjs",
    "lint": "node ../02-tokens/lint-classes.mjs && npm run lint:quality && npm run lint:parity && npm run lint:docs",
    "lint:quality": "node ../02-tokens/lint-quality.mjs",
    "gen:rac-fallback": "node scripts/gen-rac-fallback.mjs",
    "lint:docs": "node ../02-tokens/lint-docs.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "lint:parity": "node ../02-tokens/lint-parity.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.0",
    "@internationalized/string": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.470.0",
    "react-aria-components": "^1.19.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@astryxdesign/core": "0.1.8",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "http-server": "^14.1.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
